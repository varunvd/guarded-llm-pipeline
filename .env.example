# Copy to .env and adjust. The .env file is ignored by git.

# "simulated" runs fully offline with a deterministic, deliberately flawed
# stand-in model, so the pipeline and review screen work without an API key.
# "anthropic" calls a real Claude model and needs ANTHROPIC_API_KEY.
LLM_PROVIDER=simulated
LLM_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Send validated, low-risk replies automatically. When false, every reply
# waits for a person in the review screen.
AUTO_SEND=true

# How many generation attempts before falling back to a safe template.
MAX_ATTEMPTS=3

# Used only for the cost column. Set to your model's current prices.
PRICE_INPUT_PER_MTOK=4.00
PRICE_OUTPUT_PER_MTOK=20.00
